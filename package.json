{
  "name": "mix-agent-monorepo",
  "version": "0.5.4",
  "private": true,
  "description": "MIX-agent — Unified Monorepo for MIX-agent (Docker/Server/Web) and Desktop",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.11.0",
  "scripts": {
    "web:dev": "pnpm --dir apps/web dev",
    "web:build": "pnpm --dir apps/web build",
    "web:test": "pnpm --dir apps/web test",
    "web:test:coverage": "pnpm --dir apps/web test:coverage",
    "web:lint": "pnpm --dir apps/web lint",
    "web:format:check": "pnpm --dir apps/web format:check",
    "desktop:ui:dev": "pnpm --dir apps/desktop/ui dev",
    "desktop:ui:build": "pnpm --dir apps/desktop/ui build",
    "desktop:ui:test": "pnpm --dir apps/desktop/ui test",
    "desktop:ui:test:coverage": "pnpm --dir apps/desktop/ui test:coverage",
    "desktop:dev": "pnpm --dir apps/desktop tauri:dev",
    "desktop:build": "pnpm --dir apps/desktop tauri:build",
    "desktop:build:dmg": "pnpm --dir apps/desktop tauri:build:dmg",
    "desktop:build:windows": "pnpm --dir apps/desktop tauri:build:windows",
    "desktop:eval": "cargo test --manifest-path apps/desktop/Cargo.toml -p mixd-core --test coding_eval -- --nocapture",
    "desktop:eval:live": "cargo test --manifest-path apps/desktop/Cargo.toml -p mixd-core --test coding_eval -- --ignored --nocapture",
    "desktop:package": "pnpm --dir apps/desktop tauri:build:dmg",
    "licenses:generate": "node scripts/generate-third-party-licenses.mjs",
    "setup": "pnpm --dir apps/web install && pnpm --dir apps/desktop install"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.1"
  }
}
