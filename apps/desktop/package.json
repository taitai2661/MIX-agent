{
  "name": "mix-agent-desktop-workspace",
  "version": "0.5.5",
  "private": true,
  "license": "Apache-2.0",
  "description": "MIX-agent Desktop — Rust + Tauri 2 + React workspace root",
  "scripts": {
    "ui:dev": "pnpm --filter mix-agent-desktop-ui dev",
    "ui:build": "pnpm --filter mix-agent-desktop-ui build",
    "ui:test": "pnpm --filter mix-agent-desktop-ui test",
    "ui:lint": "pnpm --filter mix-agent-desktop-ui lint",
    "ui:typecheck": "pnpm --filter mix-agent-desktop-ui typecheck",
    "chromium:pin": "node scripts/pin-chromium.mjs",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:build:dmg": "tauri build --bundles dmg",
    "tauri:build:mac": "tauri build --bundles app,dmg",
    "tauri:build:windows": "tauri build --bundles nsis,msi",
    "rust:check": "cargo check --workspace --all-targets",
    "rust:fmt": "cargo fmt --all",
    "rust:fmt:check": "cargo fmt --all -- --check",
    "rust:clippy": "cargo clippy --workspace --all-targets -- -D warnings",
    "rust:test": "cargo test --workspace --all-targets",
    "rust:clean": "cargo clean --profile dev",
    "rust:clean:all": "cargo clean",
    "lint": "pnpm run rust:fmt:check && pnpm run rust:clippy && pnpm run ui:lint && pnpm run ui:typecheck",
    "test": "pnpm run rust:test && pnpm run ui:test",
    "check": "pnpm run rust:check && pnpm run ui:build"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.11.0",
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.1"
  }
}
