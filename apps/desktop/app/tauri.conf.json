{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MIX-agent Desktop",
  "version": "0.5.5",
  "identifier": "io.github.taitai2661.mix-agent-desktop",
  "build": {
    "beforeDevCommand": "pnpm --filter mix-agent-desktop-ui dev",
    "beforeBuildCommand": "pnpm --filter mix-agent-desktop-ui build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "MIX-agent Desktop",
        "width": 1200,
        "height": 800,
        "minWidth": 880,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "focus": true,
        "acceptFirstMouse": true,
        "dragDropEnabled": false,
        "titleBarStyle": "Overlay",
        "trafficLightPosition": { "x": 18, "y": 22 },
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost; font-src 'self' data:; frame-src 'self'; object-src 'none'; base-uri 'self'"
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "MIX-agent Desktop — local AI coding agent",
    "longDescription": "A Tauri 2 + Rust + React desktop application that brings the MIX-agent chat / thinking / agent experience to a single-user local install with OS Keychain integration.",
    "resources": {
      "icons/icon.svg": "icons/icon.svg",
      "../LICENSE": "LICENSE",
      "../NOTICE": "NOTICE",
      "../THIRD_PARTY_LICENSES.md": "THIRD_PARTY_LICENSES.md"
    },
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-",
      "dmg": {
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "appPosition": {
          "x": 180,
          "y": 190
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 190
        }
      }
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "wix": {
        "language": [
          "en-US"
        ]
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English",
          "Japanese"
        ],
        "displayLanguageSelector": true
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libayatana-appindicator3-1",
          "librsvg2-2",
          "libgtk-3-0",
          "libssl3",
          "libnss3",
          "libatk-bridge2.0-0",
          "libcups2",
          "libdrm2",
          "libxkbcommon0",
          "libgbm1",
          "libasound2",
          "libxcomposite1",
          "libxdamage1",
          "libxrandr2",
          "libpango-1.0-0",
          "libcairo2"
        ]
      }
    }
  },
  "plugins": {
    "cli": {
      "description": "MIX-agent Desktop command-line surface",
      "args": [
        {
          "name": "verbose",
          "short": "v",
          "description": "Increase logging verbosity"
        }
      ],
      "subcommands": {
        "doctor": {
          "description": "Print environment diagnostics",
          "args": []
        }
      }
    },
    "deep-link": {
      "desktop": {
        "schemes": [
          "mix-agent-desktop"
        ]
      }
    },
    "updater": {
      "endpoints": [
        "https://github.com/taitai2661/MIX-agent/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNERDg4M0JBMDZBMDk1REMKUldUY2xhQUd1b1BZUFVpSCtvOGw1ZHBidTN5ZEJjMndkaDR1N1pjRC9wUStUeFdOaG5UR2hjdGEK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
